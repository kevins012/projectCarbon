<main class="eco-form-main">
  <!-- Eco Background -->
  <div class="eco-form-bg">
      <div class="carbon-form-particles"></div>
      <div class="emission-form-waves"></div>
      <div class="leaf-form-pattern"></div>
  </div>

  <div class="eco-form-container">
      <div class="eco-form-card">
          <!-- Form Header -->
          <div class="eco-form-header">
              <div class="form-header-glow"></div>
              <h1 class="eco-form-title">
                  <i class="bi bi-person-gear"></i>
                  <%= datas ? 'Update Eco Profile' : 'Create Eco Profile' %>
              </h1>
              <p class="eco-form-subtitle">Manage your carbon footprint and environmental impact</p>
          </div>

          <form 
              id="ecoProfileForm" 
              enctype="multipart/form-data" 
              method="POST" 
              action="<%= datas ? '/users/update' : '/users/add-profile' %>"
              class="eco-form">
              
              <div class="eco-form-grid">
                  <!-- Full Name -->
                  <div class="eco-form-group">
                      <div class="input-eco-container">
                          <div class="eco-input-icon">
                              <i class="bi bi-person-badge"></i>
                          </div>
                          <input 
                              type="text" 
                              id="fullName" 
                              name="fullName" 
                              class="eco-input"
                              placeholder=" "
                              value="<%= datas ? datas.fullName : '' %>" 
                              required>
                          <label for="fullName" class="eco-input-label">Full Name</label>
                          <div class="eco-input-glow"></div>
                      </div>
                      <div class="eco-input-hint">Your complete identity for carbon tracking</div>
                  </div>

                  <!-- Address -->
                  <div class="eco-form-group">
                      <div class="input-eco-container">
                          <div class="eco-input-icon">
                              <i class="bi bi-geo-alt"></i>
                          </div>
                          <input 
                              type="text" 
                              id="address" 
                              name="address" 
                              class="eco-input"
                              placeholder=" "
                              value="<%= datas ? datas.address : '' %>" 
                              required>
                          <label for="address" class="eco-input-label">Operational Address</label>
                          <div class="eco-input-glow"></div>
                      </div>
                      <div class="eco-input-hint">Location for emission calculation</div>
                  </div>

                  <!-- Shop Name -->
                  <div class="eco-form-group">
                      <div class="input-eco-container">
                          <div class="eco-input-icon">
                              <i class="bi bi-shop"></i>
                          </div>
                          <input 
                              type="text" 
                              id="shopName" 
                              name="shopName" 
                              class="eco-input"
                              placeholder=" "
                              value="<%= datas ? datas.shopName : '' %>" 
                              required>
                          <label for="shopName" class="eco-input-label">Enterprise Name</label>
                          <div class="eco-input-glow"></div>
                      </div>
                      <div class="eco-input-hint">Your business identity in our ecosystem</div>
                  </div>

                  <!-- Handphone Number -->
                  <div class="eco-form-group">
                      <div class="input-eco-container">
                          <div class="eco-input-icon">
                              <i class="bi bi-phone"></i>
                          </div>
                          <input 
                              type="text" 
                              id="noHp" 
                              name="noHp" 
                              class="eco-input"
                              placeholder=" "
                              value="<%= datas ? datas.noHp : '' %>" 
                              required>
                          <label for="noHp" class="eco-input-label">Eco Contact</label>
                          <div class="eco-input-glow"></div>
                      </div>
                      <div class="eco-input-hint">For carbon emission notifications</div>
                  </div>

                  <!-- Profile Image -->
                  <div class="eco-form-group full-width">
                      <div class="eco-upload-section">
                          <div class="upload-header">
                              <i class="bi bi-camera"></i>
                              <span>Eco Profile Image</span>
                          </div>
                          
                          <div class="upload-container">
                              <!-- Image Preview -->
                              <div class="eco-preview-container">
                                  <div class="preview-frame">
                                      <img 
                                          id="ecoPreviewImg" 
                                          src="<%= datas && datas.img ? `/img/users/${datas.img}` : '/default-profile.png' %>" 
                                          alt="Eco Profile Preview" 
                                          class="eco-preview-image">
                                      <div class="preview-overlay">
                                          <i class="bi bi-arrow-repeat"></i>
                                          <span>Change Image</span>
                                      </div>
                                      <div class="preview-glow"></div>
                                  </div>
                              </div>

                              <!-- File Input -->
                              <div class="eco-file-input">
                                  <input 
                                      type="file" 
                                      id="img" 
                                      name="img" 
                                      accept="image/*"
                                      class="file-input-hidden">
                                  <label for="img" class="eco-upload-btn">
                                      <i class="bi bi-cloud-upload"></i>
                                      <span>Upload Eco Image</span>
                                  </label>
                                  <div class="upload-requirements">
                                      <i class="bi bi-info-circle"></i>
                                      Recommended: 500x500px, max 2MB
                                  </div>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>

              <!-- Submit Button -->
              <div class="eco-form-actions">
                  <button type="submit" class="eco-submit-btn">
                      <span class="btn-eco-content">
                          <i class="bi bi-<%= datas ? 'arrow-repeat' : 'plus-circle' %>"></i>
                          <%= datas ? 'Update Carbon Profile' : 'Create Eco Profile' %>
                      </span>
                      <div class="btn-eco-glow"></div>
                      <div class="btn-eco-ripple"></div>
                  </button>
                  
                  <!-- Carbon Impact Info -->
                  <div class="carbon-impact-info">
                      <div class="impact-icon">
                        <i class="bi bi-cloud-fog"></i>
                      </div>
                      <div class="impact-text">
                          <span>This profile helps track your carbon footprint</span>
                          <small>Every update contributes to better emission management</small>
                      </div>
                  </div>
              </div>
          </form>
      </div>
  </div>
</main>

<style>
/* Eco Form Design System */
.eco-form-main {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a2f0a 0%, #1a3a1a 50%, #2d4a2d 100%);
  position: relative;
  overflow: hidden;
  font-family: 'Segoe UI', system-ui, sans-serif;
  padding: 2rem 1rem;
}

/* Eco Background Effects */
.eco-form-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.carbon-form-particles {
  position: absolute;
  width: 100%;
  height: 100%;
  background: 
      radial-gradient(circle at 20% 30%, rgba(34, 139, 34, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(107, 142, 35, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 40% 80%, rgba(60, 179, 113, 0.05) 0%, transparent 50%);
  animation: carbon-form-drift 30s linear infinite;
}

.emission-form-waves {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200vw;
  height: 200vh;
  background: conic-gradient(
      from 0deg,
      transparent,
      rgba(34, 139, 34, 0.08),
      transparent,
      rgba(107, 142, 35, 0.06),
      transparent
  );
  animation: emission-form-rotate 90s linear infinite;
}

.leaf-form-pattern {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: 
      radial-gradient(2px 2px at 20px 30px, #228b22, transparent),
      radial-gradient(1px 1px at 40px 70px, rgba(107, 142, 35, 0.5), transparent),
      radial-gradient(1px 1px at 90px 40px, #3cb371, transparent);
  background-size: 200px 200px;
  opacity: 0.2;
  animation: leaf-form-float 25s linear infinite;
}

/* Main Container */
.eco-form-container {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 4rem);
}

/* Eco Form Card */
.eco-form-card {
  background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.95) 0%, 
      rgba(255, 255, 255, 0.90) 100%);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 24px;
  padding: 3rem;
  box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.1),
      0 8px 16px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  width: 100%;
  position: relative;
  overflow: hidden;
}

.eco-form-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #228b22, #3cb371, #2e8b57);
  border-radius: 24px 24px 0 0;
}

/* Form Header */
.eco-form-header {
  text-align: center;
  margin-bottom: 3rem;
  position: relative;
}

.form-header-glow {
  position: absolute;
  top: -20px;
  left: 50%;
  transform: translateX(-50%);
  width: 100px;
  height: 100px;
  background: radial-gradient(circle, rgba(34, 139, 34, 0.2), transparent 70%);
  filter: blur(20px);
}

.eco-form-title {
  font-size: 2.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #228b22, #3cb371);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.eco-form-title i {
  font-size: 2.2rem;
}

.eco-form-subtitle {
  color: #666;
  font-size: 1.1rem;
  font-weight: 500;
}

/* Form Grid */
.eco-form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-bottom: 3rem;
}

.eco-form-group.full-width {
  grid-column: 1 / -1;
}

/* Eco Input Styles */
.input-eco-container {
  position: relative;
  margin-bottom: 0.5rem;
}

.eco-input-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: #228b22;
  font-size: 1.2rem;
  z-index: 2;
  transition: all 0.3s ease;
}

.eco-input {
  width: 100%;
  padding: 1.2rem 1rem 1.2rem 3rem;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.9);
  font-size: 1rem;
  font-weight: 500;
  color: #2d3748;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.eco-input:focus {
  outline: none;
  border-color: #228b22;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 3px rgba(34, 139, 34, 0.1);
  transform: translateY(-2px);
}

.eco-input:focus + .eco-input-label,
.eco-input:not(:placeholder-shown) + .eco-input-label {
  top: -8px;
  left: 3rem;
  font-size: 0.8rem;
  color: #228b22;
  background: linear-gradient(180deg, #fff 50%, transparent 50%);
  padding: 0 0.5rem;
  z-index: 3;
}

.eco-input-label {
  position: absolute;
  left: 3rem;
  top: 50%;
  transform: translateY(-50%);
  color: #718096;
  font-size: 1rem;
  font-weight: 500;
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 2;
}

.eco-input-glow {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(34, 139, 34, 0.05), transparent);
  border-radius: 12px;
  transition: left 0.6s ease;
  z-index: 0;
}

.input-eco-container:hover .eco-input-glow {
  left: 100%;
}

.eco-input-hint {
  font-size: 0.8rem;
  color: #718096;
  margin-top: 0.25rem;
  padding-left: 0.5rem;
  font-style: italic;
}

/* Upload Section */
.eco-upload-section {
  background: linear-gradient(135deg, rgba(34, 139, 34, 0.05), rgba(60, 179, 113, 0.02));
  border: 2px dashed rgba(34, 139, 34, 0.3);
  border-radius: 16px;
  padding: 2rem;
  transition: all 0.3s ease;
}

.eco-upload-section:hover {
  border-color: rgba(34, 139, 34, 0.5);
  background: linear-gradient(135deg, rgba(34, 139, 34, 0.08), rgba(60, 179, 113, 0.05));
}

.upload-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  color: #228b22;
  font-weight: 600;
  font-size: 1.1rem;
}

.upload-header i {
  font-size: 1.3rem;
}

.upload-container {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 2rem;
  align-items: start;
}

/* Preview Container */
.eco-preview-container {
  position: relative;
}

.preview-frame {
  position: relative;
  width: 140px;
  height: 140px;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  border: 3px solid rgba(34, 139, 34, 0.3);
  transition: all 0.3s ease;
  cursor: pointer;
}

.preview-frame:hover {
  transform: scale(1.05);
  border-color: rgba(34, 139, 34, 0.6);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
}

.eco-preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: all 0.3s ease;
}

.preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(34, 139, 34, 0.9), rgba(60, 179, 113, 0.9));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  opacity: 0;
  transition: all 0.3s ease;
  gap: 0.5rem;
}

.preview-frame:hover .preview-overlay {
  opacity: 1;
}

.preview-overlay i {
  font-size: 1.5rem;
}

.preview-overlay span {
  font-size: 0.9rem;
  font-weight: 600;
}

.preview-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160px;
  height: 160px;
  background: radial-gradient(circle, rgba(34, 139, 34, 0.3), transparent 70%);
  border-radius: 50%;
  filter: blur(10px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.preview-frame:hover .preview-glow {
  opacity: 1;
}

/* File Input */
.eco-file-input {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.file-input-hidden {
  display: none;
}

.eco-upload-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  background: linear-gradient(135deg, #228b22, #3cb371);
  color: white;
  border: none;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(34, 139, 34, 0.3);
  text-decoration: none;
  justify-content: center;
}

.eco-upload-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(34, 139, 34, 0.4);
  background: linear-gradient(135deg, #1f7a1f, #34a85c);
}

.upload-requirements {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: #718096;
  padding: 0.5rem;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 8px;
  border-left: 3px solid #228b22;
}

.upload-requirements i {
  color: #228b22;
}

/* Form Actions */
.eco-form-actions {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}

.eco-submit-btn {
  position: relative;
  padding: 1.2rem 3rem;
  background: linear-gradient(135deg, #228b22, #3cb371);
  color: white;
  border: none;
  border-radius: 16px;
  font-weight: 700;
  font-size: 1.1rem;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.4s ease;
  box-shadow: 0 8px 25px rgba(34, 139, 34, 0.3);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  min-width: 280px;
}

.eco-submit-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 35px rgba(34, 139, 34, 0.4);
  background: linear-gradient(135deg, #1f7a1f, #34a85c);
}

.btn-eco-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-eco-glow {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s ease;
}

.eco-submit-btn:hover .btn-eco-glow {
  left: 100%;
}

.btn-eco-ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  transform: scale(0);
  animation: eco-ripple 0.6s linear;
  pointer-events: none;
}

/* Carbon Impact Info */
.carbon-impact-info {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.5rem;
  background: linear-gradient(135deg, rgba(34, 139, 34, 0.1), rgba(60, 179, 113, 0.05));
  border-radius: 12px;
  border: 1px solid rgba(34, 139, 34, 0.2);
  max-width: 400px;
}

.impact-icon {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #228b22, #3cb371);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.impact-text {
  flex: 1;
}

.impact-text span {
  display: block;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 0.25rem;
}

.impact-text small {
  color: #718096;
  font-size: 0.8rem;
}

/* Animations */
@keyframes carbon-form-drift {
  0% { transform: translate(0, 0); }
  100% { transform: translate(-30px, -30px); }
}

@keyframes emission-form-rotate {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes leaf-form-float {
  0% { transform: translate(0, 0); }
  100% { transform: translate(-50px, -50px); }
}

@keyframes eco-ripple {
  to {
      transform: scale(4);
      opacity: 0;
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .eco-form-main {
      padding: 1rem;
  }
  
  .eco-form-card {
      padding: 2rem 1.5rem;
  }
  
  .eco-form-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
  }
  
  .eco-form-title {
      font-size: 2rem;
      flex-direction: column;
      gap: 0.5rem;
  }
  
  .upload-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
  }
  
  .preview-frame {
      margin: 0 auto;
  }
  
  .eco-submit-btn {
      min-width: auto;
      width: 100%;
      max-width: 280px;
  }
  
  .carbon-impact-info {
      flex-direction: column;
      text-align: center;
  }
}

/* Form Entrance Animation */
.eco-form-card {
  animation: eco-form-entrance 1s ease-out;
}

@keyframes eco-form-entrance {
  from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
  }
  to {
      opacity: 1;
      transform: translateY(0) scale(1);
  }
}

/* Input Focus Effects */
.eco-input:focus ~ .eco-input-icon {
  color: #3cb371;
  transform: translateY(-50%) scale(1.1);
}

/* Custom Scrollbar */
.eco-form-main::-webkit-scrollbar {
  width: 8px;
}

.eco-form-main::-webkit-scrollbar-track {
  background: rgba(34, 139, 34, 0.1);
  border-radius: 4px;
}

.eco-form-main::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #228b22, #3cb371);
  border-radius: 4px;
}

.eco-form-main::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #1f7a1f, #34a85c);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Image Preview Functionality
  const imgInput = document.getElementById('img');
  const previewImg = document.getElementById('ecoPreviewImg');
  const previewFrame = document.querySelector('.preview-frame');

  // File input change event
  imgInput.addEventListener('change', (event) => {
      const file = event.target.files[0];
      if (file) {
          // Validate file type
          if (!file.type.startsWith('image/')) {
              showEcoMessage('Please select a valid image file', 'error');
              return;
          }

          // Validate file size (2MB)
          if (file.size > 2 * 1024 * 1024) {
              showEcoMessage('Image size should be less than 2MB', 'error');
              return;
          }

          const reader = new FileReader();
          reader.onload = (e) => {
              previewImg.src = e.target.result;
              previewFrame.classList.add('has-image');
          };
          reader.readAsDataURL(file);
      }
  });

  // Click preview to trigger file input
  previewFrame.addEventListener('click', () => {
      imgInput.click();
  });

  // Form submission enhancement
  const ecoForm = document.getElementById('ecoProfileForm');
  
  ecoForm.addEventListener('submit', function(e) {
      // Add loading state
      const submitBtn = this.querySelector('.eco-submit-btn');
      const originalText = submitBtn.innerHTML;
      
      submitBtn.innerHTML = `
          <span class="btn-eco-content">
              <i class="bi bi-arrow-repeat animate-spin"></i>
              Processing...
          </span>
      `;
      submitBtn.disabled = true;

      // Simulate form processing (remove in production)
      setTimeout(() => {
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
          showEcoMessage('Profile updated successfully!', 'success');
      }, 2000);
  });

  // Input animations
  const ecoInputs = document.querySelectorAll('.eco-input');
  
  ecoInputs.forEach(input => {
      input.addEventListener('focus', function() {
          this.parentElement.classList.add('focused');
      });
      
      input.addEventListener('blur', function() {
          if (!this.value) {
              this.parentElement.classList.remove('focused');
          }
      });

      // Check initial values
      if (input.value) {
          input.parentElement.classList.add('focused');
      }
  });

  // Eco message function
  function showEcoMessage(message, type = 'info') {
      // Create message element
      const messageEl = document.createElement('div');
      messageEl.className = `eco-message eco-message-${type}`;
      messageEl.innerHTML = `
          <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
          <span>${message}</span>
      `;

      // Add styles for message
      const style = document.createElement('style');
      style.textContent = `
          .eco-message {
              position: fixed;
              top: 20px;
              right: 20px;
              padding: 1rem 1.5rem;
              border-radius: 12px;
              color: white;
              font-weight: 600;
              display: flex;
              align-items: center;
              gap: 0.75rem;
              z-index: 10000;
              box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
              transform: translateX(400px);
              transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
          }
          .eco-message-success { background: linear-gradient(135deg, #228b22, #3cb371); }
          .eco-message-error { background: linear-gradient(135deg, #dc2626, #ef4444); }
          .eco-message-info { background: linear-gradient(135deg, #3b82f6, #60a5fa); }
          .eco-message.show { transform: translateX(0); }
      `;
      if (!document.querySelector('#eco-message-styles')) {
          style.id = 'eco-message-styles';
          document.head.appendChild(style);
      }

      document.body.appendChild(messageEl);

      // Show message
      setTimeout(() => messageEl.classList.add('show'), 100);

      // Remove message after 4 seconds
      setTimeout(() => {
          messageEl.classList.remove('show');
          setTimeout(() => {
              if (messageEl.parentNode) {
                  messageEl.parentNode.removeChild(messageEl);
              }
          }, 400);
      }, 4000);
  }

  // Add ripple effect to submit button
  const submitBtn = document.querySelector('.eco-submit-btn');
  
  submitBtn.addEventListener('click', function(e) {
      const ripple = this.querySelector('.btn-eco-ripple');
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const x = e.clientX - rect.left - size / 2;
      const y = e.clientY - rect.top - size / 2;
      
      ripple.style.cssText = `
          width: ${size}px;
          height: ${size}px;
          left: ${x}px;
          top: ${y}px;
      `;
      
      ripple.style.animation = 'none';
      void ripple.offsetWidth;
      ripple.style.animation = 'eco-ripple 0.6s linear';
  });

  // Carbon calculation display
  function updateCarbonEstimate() {
      // This could be enhanced with actual carbon calculation logic
      const shopName = document.getElementById('shopName').value;
      if (shopName) {
          const carbonEstimate = Math.floor(shopName.length * 15);
          console.log(`Estimated carbon impact for ${shopName}: ${carbonEstimate} kg CO₂`);
      }
  }

  // Add carbon estimation to shop name input
  document.getElementById('shopName').addEventListener('input', updateCarbonEstimate);
});
</script>