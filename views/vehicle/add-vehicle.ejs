<div class="form-container">
    <h1 class="form-title">Form Pengisian Data Kendaraan</h1>

    <form class="form-card" method="POST" action="/vehicle/adds" enctype="multipart/form-data">
        <div class="form-grid">
            <!-- Nomor Registrasi -->
            <div class="form-group">
                <input type="text" id="numberRegistration" name="numberRegistration" 
                       class="form-input" placeholder=" " required>
                <label for="numberRegistration" class="form-label">Nomor Registrasi</label>
            </div>

            <!-- Nama Kendaraan -->
            <div class="form-group">
                <input type="text" id="vehicle" name="vehicle" 
                       class="form-input" placeholder=" " required>
                <label for="vehicle" class="form-label">Nama Kendaraan</label>
            </div>

            <!-- Tipe Kendaraan -->
            <div class="form-group">
                <select id="typeVehicle" name="typeVehicle" class="form-input form-select" required>
                    <option value="" disabled selected></option>
                    <option value="Sedan">Sedan</option>
                    <option value="Hatchback">Hatchback</option>
                    <option value="SUV">SUV</option>
                    <option value="MPV">MPV</option>
                    <option value="Pick-up">Pick-up</option>
                    <option value="Motorcycle">Motorcycle</option>
                    <option value="Electric Vehicle">Electric Vehicle</option>
                </select>
                <label for="typeVehicle" class="form-label">Tipe Kendaraan</label>
            </div>

            <!-- Transmisi -->
            <div class="form-group">
                <select id="transmissionType" name="transmissionType" class="form-input form-select" required>
                    <option value="" disabled selected></option>
                    <option value="Manual">Manual</option>
                    <option value="Automatic">Automatic</option>
                    <option value="CVT">CVT</option>
                    <option value="DCT">DCT</option>
                </select>
                <label for="transmissionType" class="form-label">Tipe Transmisi</label>
            </div>

            <!-- Tanggal Ganti Oli -->
            <div class="form-group">
                <input type="date" id="lastOilChangeDate" name="lastOilChangeDate" 
                       class="form-input" placeholder=" " required>
                <label for="lastOilChangeDate" class="form-label">Tanggal Ganti Oli</label>
            </div>

            <!-- BBM -->
            <div class="form-group">
                <select id="fuel" name="fuel" class="form-input form-select" required>
                    <option value="" disabled selected></option>
                    <optgroup label="Bensin">
                        <option value="Pertalite">Pertalite</option>
                        <option value="Pertamax">Pertamax</option>
                        <option value="Pertamax Turbo">Pertamax Turbo</option>
                    </optgroup>
                    <optgroup label="Diesel">
                        <option value="Solar">Solar</option>
                        <option value="Pertamina Dex">Pertamina Dex</option>
                    </optgroup>
                </select>
                <label for="fuel" class="form-label">Jenis BBM</label>
            </div>

            <!-- Volume Silinder -->
            <div class="form-group">
                <input type="number" id="cylinderVolume" name="cylinderVolume" 
                       class="form-input" placeholder=" " required>
                <label for="cylinderVolume" class="form-label">Volume Silinder (cc)</label>
            </div>

            <!-- Deskripsi -->
            <div class="form-group" style="grid-column: 1 / -1;">
                <textarea id="descriptionVehicle" name="descriptionVehicle" rows="3"
                          class="form-input form-textarea" placeholder=" " required></textarea>
                <label for="descriptionVehicle" class="form-label">Deskripsi Kendaraan</label>
            </div>

            <!-- Foto Kendaraan -->
            <div class="form-group" style="grid-column: 1 / -1;">
                <div class="file-input-container" id="fileContainer">
                    <input type="file" id="vehiclePhoto" name="vehiclePhoto" 
                           accept="image/*" class="file-input" required>
                    <label for="vehiclePhoto" class="file-label">
                        <span class="file-icon">📷</span>
                        <span>Klik untuk upload foto kendaraan</span>
                        <small>atau drag & drop file di sini</small>
                    </label>
                </div>
            </div>

            <!-- Riwayat Servis -->
            <div class="form-group">
                <input type="text" id="serviceHistory" name="serviceHistory" 
                       class="form-input" placeholder=" ">
                <label for="serviceHistory" class="form-label">Riwayat Servis</label>
            </div>

            <!-- Tanggal Servis -->
            <div class="form-group">
                <input type="date" id="serviceDate" name="serviceDate" 
                       class="form-input" placeholder=" ">
                <label for="serviceDate" class="form-label">Tanggal Servis</label>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="form-group" style="grid-column: 1 / -1; margin-top: 2rem;">
            <button type="submit" class="submit-btn">
                <span>🚀 Simpan Data Kendaraan</span>
            </button>
        </div>
    </form>
</div>

<script>
// File upload drag & drop
const fileContainer = document.getElementById('fileContainer');
const fileInput = document.getElementById('vehiclePhoto');

fileContainer.addEventListener('dragover', (e) => {
    e.preventDefault();
    fileContainer.classList.add('dragover');
});

fileContainer.addEventListener('dragleave', () => {
    fileContainer.classList.remove('dragover');
});

fileContainer.addEventListener('drop', (e) => {
    e.preventDefault();
    fileContainer.classList.remove('dragover');
    fileInput.files = e.dataTransfer.files;
    
    // Update label text
    const fileName = e.dataTransfer.files[0]?.name || 'File dipilih';
    fileContainer.querySelector('span:nth-child(2)').textContent = fileName;
});

fileInput.addEventListener('change', (e) => {
    const fileName = e.target.files[0]?.name || 'Klik untuk upload foto kendaraan';
    fileContainer.querySelector('span:nth-child(2)').textContent = fileName;
});

// Form submission animation
const form = document.querySelector('form');
form.addEventListener('submit', (e) => {
    const submitBtn = form.querySelector('.submit-btn');
    submitBtn.innerHTML = '<span>⏳ Menyimpan...</span>';
    submitBtn.classList.add('form-loading');
});
</script>